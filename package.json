{
  "name": "dw",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm run gen:check && vite",
    "build": "pnpm run gen:check && tsc -b && vite build",
    "gen:model": "node scripts/gen-model.ts",
    "gen:api": "node scripts/gen-api.ts",
    "gen:check": "node scripts/gen-model.ts --check && node scripts/gen-api.ts --check",
    "api:pull": "node scripts/pull-api.ts",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.1.0",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.1"
  }
}
